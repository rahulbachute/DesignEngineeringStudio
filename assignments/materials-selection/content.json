  "activities": {
    "welcome": {
      "title": "Welcome",
      "cards": [
        {
          "title": "Engineering Materials Selection Challenge",
          "body": "Welcome to the Engineering Materials Selection challenge. In this module, you will apply fundamental material science principles to evaluate and select the optimal materials for various critical two-wheeler components.",
          "variant": "primary",
          "icon": "bi-cpu"
        }
      ]
    },
    "project-charter": {
      "title": "Project Charter",
      "cards": [
        {
          "title": "Client Objective",
          "body": "The Two-Wheeler Product Engineering Team requires a formal review of material specifications across four main sub-systems: Chassis, Engine, Wheels & Braking, and Fuel System.",
          "icon": "bi-briefcase"
        },
        {
          "title": "Deliverables",
          "body": "You are required to evaluate 12 specific components. For each component, you must identify its function, define its loading and service environment, specify required material properties, and formally recommend a primary and alternative material with engineering justification.",
          "icon": "bi-file-earmark-text"
        }
      ],
      "acceptanceText": "I accept the project charter and will document engineering reasoning."
    },
    "engineering-background": {
      "title": "Engineering Background",
      "cards": [
        {
          "title": "Material Properties & Selection",
          "body": "Material selection involves finding the best match between the performance requirements of a component and the properties of the material. Key mechanical properties include tensile strength, yield strength, stiffness (Young's modulus), toughness, and fatigue resistance.",
          "icon": "bi-book"
        }
      ]
    },
    "mission-brief": {
      "title": "Mission Brief",
      "cards": [
        {
          "title": "Design Review Stations (DRS)",
          "body": "You will rotate through four virtual Design Review Stations (DRS-01 through DRS-04). At each station, use the provided Engineering Asset sketch to identify the components.",
          "icon": "bi-geo-alt"
        },
        {
          "title": "Task Instructions",
          "body": "For every component, complete the Decision Canvas. Be thorough in your 'Engineering Justification' – clearly explain *why* your selected material is superior to alternatives for the specific loading conditions.",
          "icon": "bi-list-check"
        }
      ]
    },
