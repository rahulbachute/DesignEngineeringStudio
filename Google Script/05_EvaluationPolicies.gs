        "assessment": {
          "maxMarks": 1,
          "procedural": false,
          "allowAutomated": true,
          "checks": [
            {
              "kind": "text",
              "key": "q7_1",
              "accepted": [
                "Spur gears have only transverse contact ratio (epsilon_alpha, typically 1.2 to 1.7); Helical gears have total contact ratio epsilon_gamma = epsilon_alpha + epsilon_beta (typically 2.5 to 3.5+)"
              ]
            },
            {
              "kind": "text",
              "key": "q7_2",
              "accepted": [
                "Spur gears are best suited for low-to-moderate speeds (v < 8–10 m/s); Helical gears operate smoothly and reliably at higher speeds (v > 10–30+ m/s)"
              ]
            },
            {
              "kind": "text",
              "key": "q7_3",
              "accepted": [
                "Precision helical gears maintain a significantly higher Cv factor (e.g., 5.6 / (5.6 + sqrt(v))), reducing dynamic load amplification compared to commercial cut spur gears (e.g., 3 / (3 + v) or 4.5 / (4.5 + v))"
              ]
            },
            {
              "kind": "text",
              "key": "q7_4",
              "accepted": [
                "Because their continuous multi-tooth overlap drastically reduces gear whine, acoustic noise (< 75 dBA), and high-frequency vibration"
              ]
            }
          ],
          "reason": ""
        }
      },
