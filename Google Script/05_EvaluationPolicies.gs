              "kind": "text",
              "key": "q8_4",
              "accepted": [
                "When high operating speed, strict acoustic noise limits, or high torque density make smooth continuous engagement and reduced dynamic loading essential for transmission reliability"
              ]
            }
          ],
          "reason": ""
        }
      },
      "application-requirement-matrix": {
        "maxMarks": 1.5,
