      "given": [
        "Motorcycle Mass: 150 kg",
        "Rider Mass: 75 kg",
        "Luggage Mass: 15 kg",
        "g = 9.81 m/s2",
        "Load share on side stand = 35%",
        "Lever arm length (L) = 280 mm",
        "Hollow stand Outer Dia (D) = 22 mm",
        "Hollow stand Inner Dia (d) = 16 mm",
        "Yield Strength (Syt) = 250 MPa",
        "Critical section is at the pivot end"
      ],
      "steps": [
        {
          "id": "totalMass",
          "type": "numeric",
          "title": "Step 1: Total Mass",
          "label": "Total Mass (kg)",
          "formula": "Bike + Rider + Luggage"
        },
        {
          "id": "totalWeight",
          "type": "numeric",
          "title": "Step 2: Total Weight",
          "label": "Total Weight (N)",
          "formula": "Total Mass \u00d7 g"
        },
        {
          "id": "standLoad",
          "type": "numeric",
          "title": "Step 3: Load on Side Stand (P)",
          "label": "Load (N)",
          "formula": "Total Weight \u00d7 0.35"
        },
        {
          "id": "bendingMoment",
          "type": "numeric",
          "title": "Step 4: Maximum Bending Moment (M)",
          "label": "Bending Moment (N\u00b7mm)",
          "formula": "Load (P) \u00d7 Length (L)"
        },
        {
          "id": "sectionModulus",
          "type": "numeric",
          "title": "Step 5: Section Modulus (Z)",
          "label": "Section Modulus (mm3)",
          "formula": "(\u03c0 / 32) \u00d7 (D^4 - d^4) / D"
        },
        {
          "id": "bendingStress",
          "type": "numeric",
          "title": "Step 6: Bending Stress (\u03c3)",
          "label": "Bending Stress (MPa)",
          "formula": "Bending Moment (M) / Section Modulus (Z)"
        },
        {
          "id": "factorOfSafety",
          "type": "numeric",
          "title": "Step 7: Factor of Safety (FoS)",
          "label": "Factor of Safety",
          "formula": "Yield Strength (Syt) / Bending Stress (\u03c3)"
        }
      ]
    },
