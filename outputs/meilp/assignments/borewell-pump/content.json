    "project-context": {
      "title": "Project Context",
      "cards": [
        {
          "type": "information",
          "title": "Client Context",
          "body": "ABC Pumps Manufacturing has received field complaints that operators experience excessive operating effort, fatigue, discomfort, and poor ergonomics while using their manual borewell pumps."
        },
        {
          "type": "warning",
          "title": "Professional Responsibility",
          "body": "Management has tasked the Design Team to investigate whether the existing hand lever design is satisfactory. You must evaluate structural safety and ergonomic requirements, and recommend an improved design wherever necessary."
        },
        {
          "type": "theory",
          "title": "Ergonomics and Safety",
          "body": "A borewell pump lever acts as a first-class lever. Human factors engineering requires that the operating effort be within a comfortable range to prevent fatigue. Simultaneously, the lever must be structurally safe against maximum bending moments."
        },
        {
          "type": "hint",
          "title": "Design Focus",
          "body": "Consider the lever arm ratio (Mechanical Advantage), handle height, grip comfort, and the bending stress at the critical section near the fulcrum."
        },
        {
          "type": "student-response",
          "title": "Deliverables",
          "items": [
            "Component Identification & Working Principle",
            "Ergonomic Analysis & Free Body Diagram",
            "Force & Effort Analysis",
            "Structural Analysis & Factor of Safety",
            "Material Selection & Engineering Decision",
            "Final Engineering Report"
          ]
        }
      ],
      "acceptanceText": "I accept the project charter and will document engineering reasoning."
    },
